# Supabase project URL (Project Settings -> API)
VITE_SUPABASE_URL=your_supabase_url

# Supabase anon / publishable key (Project Settings -> API)
VITE_SUPABASE_ANON_KEY=your_vite_supabase_anon_key

# Base URL of the backend server (only used for the /api/transcribe call)
VITE_API_URL=http://localhost:3000

# Demo mode: runs the app with mock data and no backend (no Supabase
# project or server required). Voice transcription is disabled and auth
# is skipped in this mode. On by default - set to "false" to use the
# real Supabase/OpenAI backend configured above.
VITE_DEMO_MODE=false
