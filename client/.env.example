# Supabase project URL (Project Settings -> API)
VITE_SUPABASE_URL=your_supabase_url

# Supabase anon / publishable key (Project Settings -> API)
VITE_SUPABASE_ANON_KEY=your_vite_supabase_anon_key

# Base URL of the backend server (only used for the /api/transcribe call)
VITE_API_URL=http://localhost:3000
